{
  "name": "rn-expo-template",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "validate": "yarn type-check && yarn lint && yarn format:check && yarn i18n:check",
    "scaffold": "node scripts/scaffold.js",
    "doctor": "node scripts/doctor.js",
    "i18n:check": "node scripts/i18n-check.js",
    "i18n:unused": "node scripts/i18n-unused-check.js",
    "check-env": "node scripts/check-env.js"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.90.23",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.23",
    "axios": "^1.7.9",
    "date-fns": "^4.4.0",
    "expo": "~57.0.30",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.22",
