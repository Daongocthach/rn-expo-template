    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "i18next": "^25.8.13",
    "jwt-decode": "^4.0.0",
    "lucide-react-native": "^1.7.0",
    "react": "19.2.3",
